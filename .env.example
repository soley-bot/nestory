NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Hosted project URL for SOLEY / nestory:
# NEXT_PUBLIC_SUPABASE_URL=https://pfvmztxktkwyewvxfgot.supabase.co
#
# Server-only keys should never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Sentry runtime ingestion and source-map upload. Vercel provisions the
# NESTORY_ prefixed values; keep every token server-only.
NEXT_PUBLIC_NESTORY_SENTRY_DSN=
NESTORY_SENTRY_ORG=
NESTORY_SENTRY_PROJECT=
NESTORY_SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Separate issue read/write token for the local autofix automation.
SENTRY_AUTOFIX_TOKEN=
SENTRY_AUTOFIX_API_BASE=https://sentry.io
